    "@vitalize/config": "*",
    "@vitalize/models": "*",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "prisma": "^5.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "eslint": "^8.57.0",
    "prisma": "^5.18.0",
    "tslib": "^2.6.2",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  }
