{
  "name": "@vitalize/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start -c",
    "build": "echo 'Use EAS for building native binaries'",
    "lint": "eslint 'app/**/*.{ts,tsx}'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "expo": "~51.0.8",
    "expo-status-bar": "~1.11.1",
    "react": "18.2.0",
    "react-native": "0.74.3",
    "react-native-svg": "^15.2.0",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/bottom-tabs": "^6.5.20"
  },
  "devDependencies": {
    "@types/react": "^18.3.4",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.4.5"
  },
  "expo": {
    "name": "Vitalize PT",
    "slug": "vitalize-pt",
    "scheme": "vitalize",
    "plugins": [
      ["expo-build-properties", { "ios": { "useFrameworks": "static" } }]
    ]
  }
}
