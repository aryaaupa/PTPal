{
  "name": "vitalize-pt",
  "private": true,
  "version": "0.1.0",
  "description": "Vitalize PT – Make rehab feel like progress",
  "packageManager": "pnpm@9.10.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier -w .",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.3",
    "turbo": "^2.0.6",
    "typescript": "^5.6.2",
    "zod": "^3.23.8"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,css,md,json}": [
      "prettier --write"
    ]
  }
}
